[init]
  defaultBranch = master
[core]
  pager = less -FiJM~ -j3 --tabs=3
[user]
  signingkey = EEC6769A97A7BA41
[commit]
  gpgsign = true
[tag]
  forceSignAnnotated = true
[advice]
  detachedHead = false
[credential "https://github.com"]
  helper = !/usr/local/bin/gh auth git-credential
[credential "https://gist.github.com"]
  helper = !/usr/local/bin/gh auth git-credential
